rules_version = '2';

// Each (anonymous) signed-in visitor can read and write only their own data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /besties/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /besties/{uid}/photos/{photoId} {
      allow read, write: if request.auth != null && request.auth.uid == uid
                         && (request.method == 'delete' || request.resource.data.data.size() < 900000);
    }
  }
}
